# Third-party Content (City Sample, Fab, engine templates) is not committed: its license does not
# allow a public repo. Tools/VendorContent/manifest.json lists it and vendor_content.py restores it.
# Only this project's own Content folders are tracked.
/Content/*
!/Content/Takeover/
!/Content/__ExternalActors__/
!/Content/__ExternalObjects__/

# Unreal build output and caches
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaging output; per-platform icons and pak lists placed under Build/ stay tracked
Build/*
!Build/*/
Build/*/**
!Build/**/*.ico
!Build/*/PakBlacklist*.txt

# Generated IDE files
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace

# Claude Code per-user settings
.claude/settings.local.json

# Python caches (Tools/ and .github/scripts/)
__pycache__/
*.pyc
.pytest_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini
