# Normalize text line endings; scripts keep the endings their shell needs
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
# Git and Claude Code hooks run under Git Bash on Windows; CRLF breaks their shebang lines
Tools/githooks/* text eol=lf
.claude/hooks/* text eol=lf

# Unreal assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

