{
	"enabledPlugins": {
		"unreal-engine-skills-for-claude-code@claude-plugins-official": true,
		"superpowers@claude-plugins-official": true
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"shell": "bash",
						"command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(git commit *)",
						"shell": "bash",
						"command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.sh\""
					},
					{
						"type": "command",
						"if": "Bash(git add *)",
						"shell": "bash",
						"command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.sh\""
					}
				]
			},
			{
				"matcher": "mcp__.*unreal-mcp__.*",
				"hooks": [
					{
						"type": "command",
						"shell": "bash",
						"command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mcp-checkpoint.sh\""
					}
				]
			}
		]
	}
}
